# YSenseAI v4.5-Beta Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# AI API KEYS
# ============================================================================

# Anthropic Claude API Key (recommended)
# Get your key at: https://console.anthropic.com/
# Used for: AI analysis, layer extraction, collaborative distillation
# If left empty the app still runs, in offline fallback mode (no AI output).
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Anthropic model. claude-3-haiku-20240307 was retired on 19 April 2026.
# Options: claude-haiku-4-5 (default, cheapest) or claude-sonnet-5-5 (better
# layer extraction). See https://platform.claude.com/docs for current IDs.
ANTHROPIC_MODEL=claude-haiku-4-5

# Alibaba Cloud Qwen API Key (optional)
# Get your key at: https://www.alibabacloud.com/help/en/model-studio/get-api-key
# Used for: alternative layer extraction via the OpenAI-compatible endpoint
QWEN_API_KEY=

# Qwen API Base URL (Singapore region)
# Use Singapore region: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Use Beijing region: https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ============================================================================
# DATABASE (OPTIONAL)
# ============================================================================

# SQLite Database Path
# Default: ./ysense_production.db
# For production, use absolute path
DATABASE_PATH=./ysense_production.db

# ============================================================================
# SECURITY (OPTIONAL)
# ============================================================================

# JWT Secret for Session Management
# Auto-generated if not set
# For production, use a strong random string (32+ characters)
JWT_SECRET=your-secret-key-here-change-this-in-production

# ============================================================================
# APPLICATION (OPTIONAL)
# ============================================================================

# Application Environment
# Options: development, production
# Default: production
APP_ENV=production

# Debug Mode
# Options: true, false
# Default: false (disable for production)
DEBUG=false

# Log Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# ============================================================================
# DEPLOYMENT (OPTIONAL)
# ============================================================================

# Public URL (for production deployment)
# Example: https://ysenseai.org
# Default: http://localhost:8501
PUBLIC_URL=http://localhost:8501

# Port (for local development)
# Default: 8501
PORT=8501

# ============================================================================
# NOTES
# ============================================================================

# 1. Never commit .env file to version control
# 2. Keep API keys secure and rotate regularly
# 3. Use strong JWT_SECRET in production (32+ random characters)
# 4. For Google Cloud deployment, use Secret Manager instead of .env
# 5. For Docker deployment, pass environment variables via docker run -e

# ============================================================================
# GETTING API KEYS
# ============================================================================

# Anthropic Claude:
# 1. Go to https://console.anthropic.com/
# 2. Sign up or log in
# 3. Go to API Keys section
# 4. Create new key
# 5. Copy key (starts with sk-ant-api03-)

# Alibaba Cloud Qwen:
# 1. Go to https://www.alibabacloud.com/help/en/model-studio/get-api-key
# 2. Sign up or log in to Alibaba Cloud
# 3. Go to Model Studio
# 4. Create API key
# 5. Copy key (starts with sk-)
# 6. Note: Singapore and Beijing regions have different keys

# ============================================================================
# COST ESTIMATES (as of October 2026, Anthropic list prices)
# ============================================================================

# Claude Haiku 4.5: $1 per 1M input tokens, $5 per 1M output tokens
# Claude Sonnet 5.5: $2 per 1M input tokens, $10 per 1M output tokens
# A typical submission (story + 5 layers + 3-word chat) is roughly 2-4K tokens,
# so expect about $0.01-0.02 per submission on Haiku 4.5 and $0.02-0.05 on
# Sonnet 5.5. For 1,000 users at 5 submissions each: roughly $50-250 per month.

